# Default: run npm run local at the repository root to create public/deployment.json.
# To use an external deployment, set ALL THREE variables together.
# Every VITE_ value is public. Never place private keys or RPC secrets here.
# VITE_RPC_URL=https://testnet.hashio.io/api
# VITE_CHAIN_ID=296
# VITE_AUCTION_ENGINE_ADDRESS=0xYOUR_DEPLOYED_ENGINE_ADDRESS
# VITE_NETWORK_NAME=Hedera testnet
# VITE_DEPLOYMENT_BLOCK=0
# VITE_EXPLORER_URL=https://hashscan.io/testnet
