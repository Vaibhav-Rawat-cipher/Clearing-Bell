# ==========================================
# Phase 5: Hedera Testnet Deployment Config
# ==========================================

# 1. Hedera Account Credentials (for ATS SDK)
# Get these from https://portal.hedera.com/
HEDERA_OPERATOR_ID="0.0.xxxxx"
HEDERA_OPERATOR_KEY="302..."

# 2. EVM Deployer Key (for Foundry)
# This should be the ECDSA private key corresponding to your Hedera Operator ID above.
# (If you created a new account on the portal, it usually gives you a DER encoded key,
# but for Foundry you need the raw 32-byte hex string private key).
DEPLOYER_PRIVATE_KEY="0x..."

# 3. RPC URL
HEDERA_RPC_URL="https://testnet.hashio.io/api"

# ==========================================
# DO NOT FILL THESE YET - Scripts will output these
# ==========================================

# Set after running scripts/deploy-bond.ts
BOND_TOKEN_ADDRESS=""
ATS_IDENTITY_REGISTRY_ADDRESS=""

# Set after running contracts/script/Deploy.s.sol
COMPLIANCE_GATE_ADDRESS=""
AUCTION_ENGINE_ADDRESS=""
HOOK_ADDRESS=""

# Set after opening a round
ACTIVE_ROUND_ID="1"
