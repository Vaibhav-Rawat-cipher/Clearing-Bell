# =============================================================================
# Clearing Bell — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Hedera Testnet
# ---------------------------------------------------------------------------
# Your Hedera testnet account ID (format: 0.0.XXXXX)
HEDERA_ACCOUNT_ID=0.0.XXXXXX

# Your Hedera testnet private key (DER or hex format)
HEDERA_PRIVATE_KEY=your_private_key_here

# Hedera JSON-RPC Relay endpoint (for EVM-compatible calls)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# ---------------------------------------------------------------------------
# Hedera ATS (Asset Tokenization Studio)
# ---------------------------------------------------------------------------
# Deployed ATS identity registry address (filled after deploy-bond.ts runs)
ATS_IDENTITY_REGISTRY_ADDRESS=

# Deployed bond token address (filled after deploy-bond.ts runs)
BOND_TOKEN_ADDRESS=

# ---------------------------------------------------------------------------
# Auction Engine
# ---------------------------------------------------------------------------
# Deployed AuctionEngine contract address
AUCTION_ENGINE_ADDRESS=

# Deployed ComplianceGate address
COMPLIANCE_GATE_ADDRESS=

# ---------------------------------------------------------------------------
# Uniswap v4
# ---------------------------------------------------------------------------
# Uniswap v4 PoolManager address on Hedera testnet (or local anvil)
POOL_MANAGER_ADDRESS=

# Deployed ClearingBellHook address
HOOK_ADDRESS=

# ---------------------------------------------------------------------------
# Settlement token (stablecoin for bid denominations)
# ---------------------------------------------------------------------------
USDC_ADDRESS=

# ---------------------------------------------------------------------------
# Frontend / Next.js (prefix with NEXT_PUBLIC_ for client-side access)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HEDERA_RPC_URL=https://testnet.hashio.io/api
NEXT_PUBLIC_BOND_TOKEN_ADDRESS=
NEXT_PUBLIC_AUCTION_ENGINE_ADDRESS=
NEXT_PUBLIC_HOOK_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=296

# ---------------------------------------------------------------------------
# Deployment / Scripts
# ---------------------------------------------------------------------------
# Deployer private key (used in deploy scripts — testnet only)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key

# Optional: Etherscan/HashScan API key for contract verification
HASHSCAN_API_KEY=
